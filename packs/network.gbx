# OpenFactor network pack: an abstract factory of requests and responses.
#
# Nothing is dug here. Users send requests through gateways; services parse
# them, route them, query databases and render responses, all running on
# compute from server racks. Every response served pays for more. It is
# deliberately more complicated than it needs to be, to show how much happens
# between a click and a page: layers of services, logs to keep, heat to shed.

title "Network"
summary "No ore, just traffic: requests flow through parsers, routers, databases and renderers to become responses."

# Art: Kenney's 1-Bit Pack for the map, Space Station Kit models in 3D.
sheet onebit

# The four levels are the layers of the stack, from wire to application.
levels 4
span 3

belt belt name "Link" speed 24
belt fiber name "Fiber link" speed 48 style 1

resource request  name "Request"   sprite 721 tint 4a90d9
resource json     name "JSON"      sprite 768 tint f2c94c
resource query    name "Query"     sprite 675 tint b07ce0
resource rows     name "Rows"      sprite 699 tint 9fb0c0
resource response name "Response"  sprite 723 tint 3fae5a
resource error    name "Error"     sprite 1064 tint e74c3c
resource token    name "Token"     sprite 571 tint e8c34a
resource compute  name "Compute"   sprite 829 tint 4ad9d9

layer users   name "users"       sprites 827 828 tint 4a90d9 decor 45% people/character-female-a@0.5 people/character-male-b@0.5 people/character-female-c@0.5 people/character-male-e@0.5 people/character-worker@0.5
layer storage name "storage"     sprites 892 893 tint 7f8c8d decor 30% space/container-tall@0.5 space/container@0.5
layer cabling name "old cabling" sprites 743 tint 7f8c8d blocks decor space/structure-barrier
layer heat    name "heat"        haze d9534a full 400

metric served name "Responses served"
metric logged name "Errors logged"

unit balancer name "Load balancer"   sprite 1019  group "Routing" routes split model space/table-inset-small
unit firewall name "Firewall"        sprite 545  group "Routing" routes filter model space/structure-barrier
unit queue    name "Message queue"   sprite 689  group "Routing" routes tunnel range 8 model space/container-flat-open
unit up       name "Layer up"        sprite 1057 group "Routing" routes up range 3 model space/pipe-ring-colored
unit down     name "Layer down"      sprite 1059 group "Routing" routes down range 3 model space/pipe-end-colored
unit mount    name "Mount"           sprite 743 group "Routing" model space/structure
unit internet name "The internet"    sprite 680 tint 8fc7ff  group "Routing" stores shared model space/table-display-planet
unit gateway  name "Gateway"         sprite 1034  group "Edge" placeOn users model space/computer-wide
unit monolith name "Monolith"        sprite 889  group "Services" model space/wall-pillar-banner
unit parser   name "Parser"          sprite 304  group "Services" model space/computer-system
unit auth     name "Auth service"    sprite 539  group "Services" model space/computer
unit router   name "API router"      sprite 1032 group "Services" model space/table-display-small
unit database name "Database"        sprite 650 group "Services" placeOn storage model space/container-wide
unit cache    name "Cache"           sprite 523 group "Services" model space/container
unit renderer name "Renderer"        sprite 400  group "Services" model space/computer-screen
unit logger   name "Log collector"   sprite 497  group "Services" model space/skip
unit rack     name "Server rack"     sprite 404 tint 4ad9d9 group "Compute" model space/wall-pillar
unit switch   name "Switch"          sprite 946 group "Compute" links compute reach 5 model space/wall-detail

describe belt     "Carries messages one tile at a time in the direction it faces."
describe fiber    "A link twice as fast."
describe balancer "Shares traffic: takes turns sending what arrives out of its front, left and right."
describe firewall "Pick a message type in its inspector: that one passes straight on, everything else is turned aside."
describe queue    "Holds messages and delivers them to the next queue facing the same way, up to 8 tiles ahead, past anything in between."
describe up       "Carries messages up to 3 layers higher in the stack. Put one at each end of an empty shaft."
describe down     "Carries messages down to 3 layers lower. Put one at each end of an empty shaft."
describe mount    "Holds up whatever is built on the layer above."
describe internet "Where responses go. Everything it receives joins the stock that pays for new services."
describe gateway  "Takes requests from the users under it and sends them in."
describe monolith "One big program that does everything, slowly: a request in, a response out."
describe parser   "Reads requests into JSON. One in four is malformed and leaves by its left side as an error; if errors back up, it stops."
describe auth     "Checks a request's token. Signed requests are worth twice as much to the router."
describe router   "Turns JSON into database queries."
describe database "Answers queries with rows. Only runs where there is storage."
describe cache    "Answers queries from memory: anywhere, and faster than a database."
describe renderer "Turns rows into responses. Each one is counted."
describe logger   "Collects errors so parsers don't stall. Each one is counted."
describe rack     "Gives compute to everything on its switches, and heats the tiles around it. Racks too close together overheat and stop."
describe switch   "Joins services and racks within 5 steps of it into one compute network."
describe request  "What users send. Comes in through gateways."
describe json     "A parsed request."
describe query    "A question for the database."
describe rows     "What the database answers."
describe response "What users wanted. Pays for everything."
describe error    "A malformed request. Has to go somewhere."
describe token    "Proof of who sent a request. Issued by the auth service."
describe compute  "Shared through switches. Never travels on links."
describe microservices "Split the monolith: parsers, routers, databases, renderers and log collectors."
describe loadBalancing "Load balancers and firewalls."
describe messaging     "Message queues, to send traffic past everything in between."
describe caching       "Caches, which answer from memory."
describe authentication "The auth service and signed requests."
describe stack         "Build on higher layers of the stack."
describe fiberLinks    "Fiber links, twice as fast."

unitRule listen
    appliesTo gateway
    rate 20
    map users atLeast 1
    local request out 1
end

unitRule doEverything
    appliesTo monolith
    rate 90
    local request in 1
    network compute in 3
    local response out 1
    log served 1
end

unitRule parse
    appliesTo parser
    rate 30
    local request in 4
    network compute in 2
    local json out 3
    local error out 1 left
end
unitRule signIn
    appliesTo auth
    rate 60
    local request in 2
    network compute in 2
    local token out 2
end
unitRule route
    appliesTo router
    rate 20
    local json in 1
    network compute in 1
    local query out 1
end
unitRule routeSigned
    appliesTo router
    rate 20
    local token in 1
    network compute in 1
    local query out 2
end
unitRule answer
    appliesTo database
    rate 40
    map storage atLeast 1
    local query in 2
    network compute in 4
    local rows out 2
end
unitRule remember
    appliesTo cache
    rate 15
    local query in 2
    network compute in 2
    local rows out 2
end
unitRule render
    appliesTo renderer
    rate 30
    local rows in 1
    network compute in 2
    local response out 1
    log served 1
end
unitRule collect
    appliesTo logger
    rate 20
    local error in 1
    log logged 1
end

unitRule serve
    appliesTo rack
    rate 60
    map heat atMost 250
    network compute out 30
    map heat out 6 radius 2
end

# Heat leaves by itself, fast enough for one rack but not for two side by side.
mapRule airflow
    rate 30
    map heat in 3
end

patch users   at 0 0   size 4 10  amount 1
patch storage at 18 2  size 4 4   amount 1

stock response 150

cost belt     response 1
cost fiber    response 3
cost balancer response 6
cost firewall response 8
cost queue    response 10
cost up       response 12
cost down     response 10
cost mount    response 4
cost internet response 10
cost gateway  response 8
cost monolith response 20
cost parser   response 20
cost auth     response 40 rows 20
cost router   response 15
cost database response 30
cost cache    response 40 rows 30
cost renderer response 20
cost logger   response 10
cost rack     response 25
cost switch   response 2

research microservices
    name "Microservices"
    cost response 150
    time 300
    unlocks parser router database renderer logger
end
research loadBalancing
    name "Load balancing"
    cost response 80
    time 300
    unlocks balancer firewall
end
research messaging
    name "Message queues"
    requires loadBalancing
    cost response 200 rows 40
    time 450
    unlocks queue
end
research caching
    name "Caching"
    requires microservices
    cost response 300 rows 100
    time 600
    unlocks cache
end
research authentication
    name "Authentication"
    requires microservices
    cost response 300 json 100
    time 600
    unlocks auth routeSigned
end
research stack
    name "Up the stack"
    requires messaging
    cost response 400
    time 600
    unlocks up down mount
end
research fiberLinks
    name "Fiber"
    requires loadBalancing
    cost response 300 rows 60
    time 600
    unlocks fiber
end

# The opening: a gateway, one monolith on one rack, and the internet.
place gateway 3 4 east
place belt 4 4 east count 3
place monolith 7 4 east
place belt 8 4 east count 3
place internet 11 4 east
place rack 7 6 east
place switch 7 5 east

puzzle helloWorld
    name "Hello, world"
    about "The monolith works, just slowly. Add gateways, monoliths and racks and serve 100 responses."
    goal deliver response 100
end
puzzle splitIt
    name "Split the monolith"
    about "Research microservices, then serve 50 responses through a parser, a router, a database and a renderer."
    goal research microservices
    goal make rows 50
    goal deliver response 50
end
puzzle mindTheLogs
    name "Mind the logs"
    about "Parsers stall when their errors back up. Collect 100 errors in log collectors."
    goal metric logged 100
end
puzzle keepCool
    name "Keep it cool"
    about "Racks side by side overheat and stop. Spread them out, join them with switches and serve 600 responses."
    goal metric served 600
end
puzzle scaleOut
    name "Scale out"
    about "Serve 5000 responses. Caches, signed requests and fiber all help. After that, it just keeps growing."
    goal metric served 5000
end

puzzle trafficSpike
    name "Traffic spike"
    about "Launch day. A fresh data center, a narrow strip of users and five minutes: serve 400 responses."
    fresh
    patch users   at 0 0   size 2 6 amount 1
    patch storage at 10 0  size 3 3 amount 1
    stock response 260
    place none
    researched microservices loadBalancing
    goal metric served 400
    limit 18000
end

# Chapter puzzles: each on a fresh map. Their solutions are in
# crates/sim/tests/solutions/network.sol.

# Localhost: before any research, one program does everything.
puzzle ping
    chapter "Localhost"
    name "Ping"
    about "Before anything clever: a gateway on the users, a link, and the internet. Echo 30 requests straight back out."
    fresh
    patch users at 0 3 size 2 3 amount 1
    stock response 40
    place none
    only belt gateway internet
    goal deliver request 30
end
