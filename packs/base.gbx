# OpenFactor base pack.
#
# Ore comes out of the ground, is smelted, assembled and finally built into
# automata. Coal furnaces need no power but foul the air. Powered machines are
# faster, and need a steam or tar plant, water and oil over pipes, and poles.
# Everything delivered to a depot joins the stock that pays for buildings and research.

# The factory can stack four levels high. Above the ground, a building needs
# something on the level below within three tiles of it.
levels 4
span 3

belt belt name "Belt" speed 16 model conveyor corner conveyor-corner
belt express name "Express belt" speed 32 style 1 model conveyor-stripe corner conveyor-stripe-corner

# Raw materials
resource ironOre     name "Iron ore"     sprite 96
resource copperOre   name "Copper ore"   sprite 97
resource coal        name "Coal"         sprite 96 tint 26262e
resource stone       name "Stone"        sprite 96 tint c9b89a
resource tungstenOre name "Tungsten ore" sprite 96 tint 8d5fc4

# Moved over networks rather than belts
resource power name "Power"     sprite 129
resource water name "Water"     sprite 86
resource crude name "Crude oil" sprite 73 tint 3a2f3a

# Materials
resource ironPlate   name "Iron plate"   sprite 107
resource copperPlate name "Copper plate" sprite 107 tint d07f43
resource brick       name "Brick"        sprite 107 tint b5533c
resource steel       name "Steel"        sprite 107 tint 3f4b63
resource carbide     name "Carbide"      sprite 130 tint a86ee0
resource plastic     name "Plastic"      sprite 74
resource tar         name "Tar"          sprite 85 tint 2d2830

# Parts
resource gear       name "Gear"       sprite 114
resource wire       name "Wire"       sprite 130 tint d07f43
resource circuit    name "Circuit"    sprite 57 tint 3fae5a
resource motor      name "Motor"      sprite 102
resource controller name "Controller" sprite 129 tint 4a90d9
resource automaton  name "Automaton"  sprite 120

layer ironField     name "iron ground"     sprites 3 32 tint 6f8fb8
layer copperField   name "copper ground"   sprites 3 32 tint c8763c
layer coalField     name "coal ground"     sprites 3 32 tint 15151a
layer stoneField    name "stone ground"    sprites 3 32 tint b9a888
layer tungstenField name "tungsten ground" sprites 3 32 tint 8d5fc4
layer waterField    name "water"           sprites 3    tint 2f7fd6
layer oilField      name "oil seep"        sprites 3 32 tint 3a2f3a
layer smog          name "smog"            haze 4d4636 full 500

metric energy    name "Energy used"
metric automata  name "Automata built"

# Logistics
unit splitter name "Splitter"  sprite 72  group "Logistics" routes split model conveyor-cross
unit sorter   name "Sorter"    sprite 79  group "Logistics" routes filter model scanner-low
unit tunnel   name "Tunnel"    sprite 68  group "Logistics" routes tunnel range 5 model machine-connection-hole
unit hoist    name "Hoist"     sprite 127 group "Logistics" routes up range 3 model crane-lift
unit chute    name "Chute"     sprite 109 group "Logistics" routes down range 3 model hopper-square
unit pillar   name "Pillar"    sprite 128 group "Logistics" model structure-yellow-tall
unit depot    name "Depot"     sprite 58  group "Logistics" stores shared model box-wide
# Extraction
unit drill      name "Drill"       sprite 110 group "Extraction" placeOn ironField placeOn copperField placeOn coalField placeOn stoneField model piston-round
unit powerDrill name "Power drill" sprite 98  group "Extraction" placeOn ironField placeOn copperField placeOn coalField placeOn stoneField placeOn tungstenField model piston-square
unit pump       name "Pump"        sprite 90  group "Extraction" placeOn waterField model pipe-large-valve
unit derrick    name "Derrick"     sprite 128 group "Extraction" placeOn oilField model robot-arm-b
# Production
unit furnace   name "Coal furnace"  sprite 92  group "Production" model hopper-round
unit arc       name "Arc furnace"   sprite 75  group "Production" model machine-fortified
unit workshop  name "Workshop"      sprite 87  group "Production" model machine
unit assembly  name "Assembly line" sprite 99  group "Production" model machine-window-bar
unit refinery  name "Refinery"      sprite 111 group "Production" model machine-connection-pipe
# Utilities
unit steam  name "Steam plant"  sprite 109 group "Utilities" model hopper-high-round
unit burner name "Tar burner"   sprite 108 group "Utilities" model hopper-high-square
unit solar  name "Solar panel"  sprite 22  group "Utilities" model screen-flat
unit pole   name "Power pole"   sprite 116 group "Utilities" links power reach 5 model structure-tall
unit pipe   name "Pipe"         sprite 91  group "Utilities" links water reach 1 links crude reach 1 model button-floor-round
# --- Drills. Whichever rule's ground is under the drill is the one that runs.

unitRule drillIron
    appliesTo drill
    rate 60
    map ironField in 1
    local ironOre out 1
end
unitRule drillCopper
    appliesTo drill
    rate 60
    map copperField in 1
    local copperOre out 1
end
unitRule drillCoal
    appliesTo drill
    rate 60
    map coalField in 1
    local coal out 1
end
unitRule drillStone
    appliesTo drill
    rate 60
    map stoneField in 1
    local stone out 1
end

unitRule powerDrillIron
    appliesTo powerDrill
    rate 20
    map ironField in 1
    network power in 2
    local ironOre out 1
end
unitRule powerDrillCopper
    appliesTo powerDrill
    rate 20
    map copperField in 1
    network power in 2
    local copperOre out 1
end
unitRule powerDrillCoal
    appliesTo powerDrill
    rate 20
    map coalField in 1
    network power in 2
    local coal out 1
end
unitRule powerDrillStone
    appliesTo powerDrill
    rate 20
    map stoneField in 1
    network power in 2
    local stone out 1
end
# Only powered drills can cut tungsten.
unitRule powerDrillTungsten
    appliesTo powerDrill
    rate 40
    map tungstenField in 1
    network power in 4
    local tungstenOre out 1
end

unitRule pumpWater
    appliesTo pump
    rate 30
    map waterField atLeast 1
    network water out 20
end
unitRule pumpCrude
    appliesTo derrick
    rate 60
    map oilField atLeast 1
    network power in 3
    network crude out 10
end

# --- Coal furnaces burn coal, need no power, and stop when the air gets too thick.

unitRule furnaceIron
    appliesTo furnace
    rate 120
    map smog atMost 300
    local ironOre in 2
    local coal in 1
    local ironPlate out 2
    map smog out 12 radius 1
    log -timestamp=Time energy 4
end
unitRule furnaceCopper
    appliesTo furnace
    rate 120
    map smog atMost 300
    local copperOre in 2
    local coal in 1
    local copperPlate out 2
    map smog out 12 radius 1
    log -timestamp=Time energy 4
end
unitRule furnaceBrick
    appliesTo furnace
    rate 150
    map smog atMost 300
    local stone in 3
    local coal in 1
    local brick out 2
    map smog out 12 radius 1
    log -timestamp=Time energy 4
end

# --- Arc furnaces are clean and fast, and the only way to make steel and carbide.

unitRule arcIron
    appliesTo arc
    rate 40
    local ironOre in 2
    network power in 6
    local ironPlate out 2
    log -timestamp=Time energy 6
end
unitRule arcCopper
    appliesTo arc
    rate 40
    local copperOre in 2
    network power in 6
    local copperPlate out 2
    log -timestamp=Time energy 6
end
unitRule arcBrick
    appliesTo arc
    rate 60
    local stone in 3
    network power in 8
    local brick out 2
    log -timestamp=Time energy 8
end
unitRule arcSteel
    appliesTo arc
    rate 150
    local ironPlate in 3
    local coal in 1
    network power in 15
    local steel out 1
    log -timestamp=Time energy 15
end
unitRule arcCarbide
    appliesTo arc
    rate 120
    local tungstenOre in 1
    local coal in 2
    network power in 20
    local carbide out 1
    log -timestamp=Time energy 20
end

# --- Workshops are slow and unpowered. Assembly lines are fast and make everything.

unitRule workshopGear
    appliesTo workshop
    rate 90
    local ironPlate in 2
    local gear out 1
end
unitRule workshopWire
    appliesTo workshop
    rate 60
    local copperPlate in 1
    local wire out 2
end
unitRule workshopCircuit
    appliesTo workshop
    rate 150
    local ironPlate in 1
    local wire in 3
    local circuit out 1
end

unitRule assemblyGear
    appliesTo assembly
    rate 30
    local ironPlate in 2
    network power in 3
    local gear out 1
    log -timestamp=Time energy 3
end
unitRule assemblyWire
    appliesTo assembly
    rate 20
    local copperPlate in 1
    network power in 2
    local wire out 2
    log -timestamp=Time energy 2
end
unitRule assemblyCircuit
    appliesTo assembly
    rate 50
    local ironPlate in 1
    local wire in 3
    network power in 5
    local circuit out 1
    log -timestamp=Time energy 5
end
unitRule assemblyMotor
    appliesTo assembly
    rate 120
    local steel in 1
    local gear in 2
    local wire in 4
    network power in 15
    local motor out 1
    log -timestamp=Time energy 15
end
unitRule assemblyController
    appliesTo assembly
    rate 180
    local circuit in 2
    local plastic in 1
    local carbide in 1
    network power in 25
    local controller out 1
    log -timestamp=Time energy 25
end
unitRule assemblyAutomaton
    appliesTo assembly
    rate 360
    local motor in 1
    local controller in 1
    local brick in 4
    network power in 60
    local automaton out 1
    log -timestamp=Time energy 60
    log automata 1
end

# Tar leaves from the refinery's left side. If it backs up, the refinery stops.
unitRule refine
    appliesTo refinery
    rate 120
    network crude in 10
    network water in 5
    network power in 10
    local plastic out 2
    local tar out 1 left
    log -timestamp=Time energy 10
end

# --- Power

unitRule steamPower
    appliesTo steam
    rate 120
    local coal in 1
    network water in 5
    network power out 60
    map smog out 18 radius 1
end
unitRule burnTar
    appliesTo burner
    rate 120
    local tar in 1
    network power out 40
    map smog out 24 radius 1
end
unitRule sunlight
    appliesTo solar
    rate 300
    network power out 10
end

# Smog thins out by itself, so spacing dirty machines apart keeps them running.
mapRule smogClears
    rate 30
    map smog in 3
end

# --- The starting map

patch ironField     at 0 0    size 7 6 amount 100000
patch coalField     at 0 8    size 7 5 amount 100000
patch copperField   at 16 11  size 6 5 amount 100000
patch waterField    at 10 14  size 5 4 amount 1000
patch stoneField    at -8 3   size 5 6 amount 100000
patch tungstenField at 28 3   size 5 4 amount 100000
patch oilField      at 24 18  size 5 4 amount 100000

# --- What things cost. Depots feed the shared stock that pays for all of it.
# Removing a building refunds it in full.

stock ironPlate 150 gear 30

cost belt       ironPlate 1
cost express    ironPlate 2 gear 1
cost splitter   ironPlate 4 gear 2
cost sorter     ironPlate 4 gear 2 circuit 1
cost tunnel     ironPlate 6
cost hoist      ironPlate 8 gear 2
cost chute      ironPlate 6
cost pillar     ironPlate 3
cost depot      ironPlate 10
cost drill      ironPlate 8 gear 3
cost powerDrill steel 4 gear 6 wire 6
cost pump       ironPlate 5 gear 2
cost derrick    steel 10 gear 8 wire 10
cost furnace    ironPlate 6
cost arc        steel 4 wire 12 brick 10
cost workshop   ironPlate 8 gear 4
cost assembly   steel 10 gear 10 circuit 6
cost refinery   steel 20 circuit 10 brick 20
cost steam      ironPlate 20 gear 6 brick 10
cost burner     steel 6 brick 10
cost solar      copperPlate 20 circuit 4
cost pole       ironPlate 2 wire 2
cost pipe       ironPlate 1

# --- The research tree

research routing
    name "Routing"
    cost ironPlate 30 gear 10
    time 300
    unlocks splitter tunnel
end
research copperWorking
    name "Copper working"
    cost ironPlate 40
    time 300
    unlocks furnaceCopper workshopWire
end
research masonry
    name "Masonry"
    cost ironPlate 40 gear 10
    time 300
    unlocks furnaceBrick
end
research electricity
    name "Electricity"
    requires copperWorking masonry
    cost copperPlate 40 wire 40 brick 20
    time 600
    unlocks steam pump pipe pole
end
research metallurgy
    name "Metallurgy"
    requires electricity
    cost ironPlate 80 brick 40 wire 40
    time 600
    unlocks arc arcSteel
end
research electronics
    name "Electronics"
    requires electricity
    cost ironPlate 60 wire 80
    time 600
    unlocks workshopCircuit sorter
end
research expressBelts
    name "Express belts"
    requires routing metallurgy
    cost steel 20 gear 60
    time 600
    unlocks express
end
research poweredMining
    name "Powered mining"
    requires metallurgy
    cost steel 30 gear 40 wire 40
    time 900
    unlocks powerDrill
end
research solarPower
    name "Solar power"
    requires electronics
    cost copperPlate 60 circuit 30
    time 900
    unlocks solar
end
research automation
    name "Automation"
    requires metallurgy electronics
    cost steel 40 gear 60 circuit 40
    time 1200
    unlocks assembly
end
research tungsten
    name "Tungsten carbide"
    requires poweredMining
    cost steel 60 circuit 60
    time 1200
    unlocks powerDrillTungsten arcCarbide
end
research petroleum
    name "Petroleum"
    requires automation
    cost steel 80 circuit 80 brick 60
    time 1800
    unlocks derrick refinery burner
end
research motors
    name "Motors"
    requires automation
    cost steel 80 gear 200 wire 200
    time 1800
    unlocks assemblyMotor
end
research robotics
    name "Robotics"
    requires tungsten petroleum motors
    cost motor 30 carbide 30 plastic 60
    time 3600
    unlocks assemblyController assemblyAutomaton
end
research elevation
    name "Elevated logistics"
    requires routing
    cost ironPlate 60 gear 6
    time 480
    unlocks hoist chute pillar
end

# --- The opening factory: iron and coal into a furnace, plates into a depot.

place drill 2 2 east
place belt 3 2 east count 6
place drill 2 9 east
place belt 3 9 east count 6
place belt 9 9 north count 7
place furnace 9 2 east
place belt 10 2 east count 10
place depot 20 2 east
