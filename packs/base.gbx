# OpenFactor base pack.
title "Factory"
summary "Ore to plates to parts to automata: the full chain, with power, oil and four levels to build on."
#
# Ore comes out of the ground, is smelted, assembled and finally built into
# automata. Coal furnaces need no power but foul the air. Powered machines are
# faster, and need a steam or tar plant, water and oil over pipes, and poles.
# Everything delivered to a depot joins the stock that pays for buildings and research.

# The factory can stack four levels high. Above the ground, a building needs
# something on the level below within three tiles of it.
levels 4
span 3

belt belt name "Belt" speed 16 model conveyor corner conveyor-corner
belt express name "Express belt" speed 32 style 1 model conveyor-stripe corner conveyor-stripe-corner

# Raw materials
resource ironOre     name "Iron ore"     sprite 96 tint 8fa3c0 model survival/resource-stone
resource copperOre   name "Copper ore"   sprite 97 tint d07f43 model survival/resource-stone
resource coal        name "Coal"         sprite 96 tint 26262e model survival/resource-stone
resource stone       name "Stone"        sprite 96 tint c9b89a model survival/resource-stone-large
resource tungstenOre name "Tungsten ore" sprite 96 tint 8d5fc4 model survival/resource-stone

# Moved over networks rather than belts
resource power name "Power"     sprite 129
resource water name "Water"     sprite 86
resource crude name "Crude oil" sprite 73 tint 3a2f3a

# Materials
resource ironPlate   name "Iron plate"   sprite 107 model survival/metal-panel
resource copperPlate name "Copper plate" sprite 107 tint d07f43 model survival/metal-panel
resource brick       name "Brick"        sprite 107 tint b5533c model survival/metal-panel
resource steel       name "Steel"        sprite 107 tint 3f4b63 model survival/metal-panel
resource carbide     name "Carbide"      sprite 130 tint a86ee0 model box-small
resource plastic     name "Plastic"      sprite 74 model box-small
resource tar         name "Tar"          sprite 85 tint 2d2830

# Parts
resource gear       name "Gear"       sprite 114 model cog-a
resource wire       name "Wire"       sprite 130 tint d07f43
resource circuit    name "Circuit"    sprite 57 tint 3fae5a model screen-panel-small
resource motor      name "Motor"      sprite 102 model cog-c
resource controller name "Controller" sprite 129 tint 4a90d9 model screen-small
resource automaton  name "Automaton"  sprite 120 model people/character-robot

layer ironField     name "iron ground"     sprites 3 32 tint 6f8fb8 decor 45% survival/rock-a@0.45 survival/rock-b@0.45 survival/rock-c@0.4
layer copperField   name "copper ground"   sprites 3 32 tint c8763c decor 45% survival/rock-a@0.45 survival/rock-b@0.45 survival/rock-c@0.4
layer coalField     name "coal ground"     sprites 3 32 tint 15151a decor 45% survival/rock-a@0.45 survival/rock-c@0.4
layer stoneField    name "stone ground"    sprites 3 32 tint b9a888 decor 45% survival/rock-b@0.5 survival/rock-flat@0.6
layer tungstenField name "tungsten ground" sprites 3 32 tint 8d5fc4 decor 45% survival/rock-a@0.45 survival/rock-b@0.45
layer waterField    name "water"           sprites 3    tint 2f7fd6
layer oilField      name "oil seep"        sprites 3 32 tint 3a2f3a decor 35% survival/rock-flat@0.5
layer smog          name "smog"            haze 4d4636 full 500

metric energy    name "Energy used"
metric automata  name "Automata built"

# Logistics
unit splitter name "Splitter"  sprite 72  group "Logistics" routes split model conveyor-cross
unit sorter   name "Sorter"    sprite 79  group "Logistics" routes filter model scanner-low
unit tunnel   name "Tunnel"    sprite 68  group "Logistics" routes tunnel range 5 model machine-connection-hole
unit hoist    name "Hoist"     sprite 127 group "Logistics" routes up range 3 model crane-lift
unit chute    name "Chute"     sprite 109 group "Logistics" routes down range 3 model hopper-square
unit pillar   name "Pillar"    sprite 128 group "Logistics" model structure-yellow-tall
unit depot    name "Depot"     sprite 58  group "Logistics" stores shared model box-wide
# Extraction
unit drill      name "Drill"       sprite 110 group "Extraction" placeOn ironField placeOn copperField placeOn coalField placeOn stoneField model piston-round
unit powerDrill name "Power drill" sprite 98  group "Extraction" placeOn ironField placeOn copperField placeOn coalField placeOn stoneField placeOn tungstenField model piston-square
unit pump       name "Pump"        sprite 90  group "Extraction" placeOn waterField model pipe-large-valve
unit derrick    name "Derrick"     sprite 128 group "Extraction" placeOn oilField model robot-arm-b
# Production
unit furnace   name "Coal furnace"  sprite 92  group "Production" model hopper-round
unit arc       name "Arc furnace"   sprite 75  group "Production" model machine-fortified
unit workshop  name "Workshop"      sprite 87  group "Production" model machine
unit assembly  name "Assembly line" sprite 99  group "Production" model machine-window-bar
unit refinery  name "Refinery"      sprite 111 group "Production" model machine-connection-pipe
# Utilities
unit steam  name "Steam plant"  sprite 109 group "Utilities" model hopper-high-round
unit burner name "Tar burner"   sprite 108 group "Utilities" model hopper-high-square
unit solar  name "Solar panel"  sprite 22  group "Utilities" model screen-flat
unit pole   name "Power pole"   sprite 116 group "Utilities" links power reach 5 model structure-tall
unit pipe   name "Pipe"         sprite 91  group "Utilities" links water reach 1 links crude reach 1 model button-floor-round
# --- What each thing is, in the player's words. The game works out the
# recipes, costs and requirements from the rest of the pack.

describe belt       "Carries items one tile at a time in the direction it faces. Drag to lay a line; it turns corners by itself."
describe express    "A belt that carries items twice as fast. Swap it in where a line backs up."
describe splitter   "Takes turns sending what arrives out of its front, left and right, to share one line between several."
describe sorter     "Pick a resource in its inspector: that one goes straight on, everything else leaves by the sides."
describe tunnel     "Sends items underground to the next tunnel facing the same way, up to 5 tiles ahead, past anything in between."
describe hoist      "Lifts items up to 3 levels. Put a hoist at each end of an empty shaft; items leave from the front of the top one."
describe chute      "Drops items up to 3 levels. Put a chute at each end of an empty shaft; items leave from the front of the bottom one."
describe pillar     "Does nothing but hold up whatever is built above it, so upper levels can reach further."
describe depot      "Accepts anything. What it receives joins the shared stock that pays for buildings and research."
describe drill      "Digs whatever ore or stone is under it, slowly and without power. Each dig uses up the ground a little."
describe powerDrill "Digs three times faster than a drill and is the only way to cut tungsten. Needs power."
describe pump       "Fills the pipes around it with water. Build it on water."
describe derrick    "Pumps crude oil into pipes. Build it on an oil seep; needs power."
describe furnace    "Smelts ore with coal. Needs no power, but fouls the air, and stops when the smog around it gets too thick."
describe arc        "A clean, fast electric furnace, and the only way to make steel and carbide."
describe workshop   "Makes basic parts by hand, without power. Choose a recipe in its inspector or let it pick."
describe assembly   "A fast powered machine that can make every part, up to the automata at the end of the chain."
describe refinery   "Turns crude oil and water into plastic, with tar out of its left side. If the tar backs up, it stops."
describe steam      "Burns coal with water from pipes to power everything connected to it. Makes smog."
describe burner     "Burns the refinery's tar for power, so the waste has somewhere useful to go. Makes smog."
describe solar      "Gives a little power all the time, for free and without smog."
describe pole       "Joins power users and producers within 5 steps of it into one network."
describe pipe       "Carries water and crude oil to the pipes, pumps and machines next to it."

describe ironOre     "Dug from iron ground. Smelt it into iron plates."
describe copperOre   "Dug from copper ground. Smelt it into copper plates."
describe coal        "Dug from coal ground. Fuel for coal furnaces and steam plants."
describe stone       "Dug from stone ground. Fired into bricks."
describe tungstenOre "Only a power drill can cut it. Becomes carbide in an arc furnace."
describe power       "Shared by everything on a power network, joined by poles. Never travels on belts."
describe water       "Pumped into pipes for steam plants and refineries."
describe crude       "Pumped from oil seeps into pipes, then refined into plastic."
describe ironPlate   "The most used material. Pays for most early buildings."
describe copperPlate "Drawn into wire."
describe brick       "For furnaces, plants, refineries and the bodies of automata."
describe steel       "Strong iron made in an arc furnace. Pays for powered machines."
describe carbide     "Hard tungsten material for the controllers of automata."
describe plastic     "Made in the refinery. Goes into controllers."
describe tar         "Refinery waste. Burn it for power, or the refinery stops."
describe gear        "The basic moving part."
describe wire        "Drawn from copper. Goes into circuits, motors and power poles."
describe circuit     "Electronics for sorters, solar panels and better machines."
describe motor       "Gives automata their movement."
describe controller  "The brain of an automaton."
describe automaton   "The end of the production chain. Each one built is counted."

describe routing       "Splitters and tunnels, to share lines and pass belts under each other."
describe copperWorking "Smelting copper and drawing it into wire."
describe masonry       "Firing stone into bricks."
describe electricity   "Steam power, pumps, pipes and poles: the start of powered machines."
describe metallurgy    "The arc furnace and steel."
describe electronics   "Circuits, and the sorter that uses them."
describe expressBelts  "Belts that carry twice as much."
describe poweredMining "Drills that dig three times faster."
describe solarPower    "Clean power that needs no fuel."
describe automation    "The assembly line, which makes every part quickly."
describe tungsten      "Cutting tungsten and making carbide from it."
describe petroleum     "Oil, plastic, and burning tar for power."
describe motors        "Assembling motors."
describe robotics      "Controllers and automata, the end of the chain."
describe elevation     "Hoists, chutes and pillars, to build on levels above the ground."

# --- Drills. Whichever rule's ground is under the drill is the one that runs.

unitRule drillIron
    appliesTo drill
    rate 60
    map ironField in 1
    local ironOre out 1
end
unitRule drillCopper
    appliesTo drill
    rate 60
    map copperField in 1
    local copperOre out 1
end
unitRule drillCoal
    appliesTo drill
    rate 60
    map coalField in 1
    local coal out 1
end
unitRule drillStone
    appliesTo drill
    rate 60
    map stoneField in 1
    local stone out 1
end

unitRule powerDrillIron
    appliesTo powerDrill
    rate 20
    map ironField in 1
    network power in 2
    local ironOre out 1
end
unitRule powerDrillCopper
    appliesTo powerDrill
    rate 20
    map copperField in 1
    network power in 2
    local copperOre out 1
end
unitRule powerDrillCoal
    appliesTo powerDrill
    rate 20
    map coalField in 1
    network power in 2
    local coal out 1
end
unitRule powerDrillStone
    appliesTo powerDrill
    rate 20
    map stoneField in 1
    network power in 2
    local stone out 1
end
# Only powered drills can cut tungsten.
unitRule powerDrillTungsten
    appliesTo powerDrill
    rate 40
    map tungstenField in 1
    network power in 4
    local tungstenOre out 1
end

unitRule pumpWater
    appliesTo pump
    rate 30
    map waterField atLeast 1
    network water out 20
end
unitRule pumpCrude
    appliesTo derrick
    rate 60
    map oilField atLeast 1
    network power in 3
    network crude out 10
end

# --- Coal furnaces burn coal, need no power, and stop when the air gets too thick.

unitRule furnaceIron
    appliesTo furnace
    rate 120
    map smog atMost 300
    local ironOre in 2
    local coal in 1
    local ironPlate out 2
    map smog out 12 radius 1
    log -timestamp=Time energy 4
end
unitRule furnaceCopper
    appliesTo furnace
    rate 120
    map smog atMost 300
    local copperOre in 2
    local coal in 1
    local copperPlate out 2
    map smog out 12 radius 1
    log -timestamp=Time energy 4
end
unitRule furnaceBrick
    appliesTo furnace
    rate 150
    map smog atMost 300
    local stone in 3
    local coal in 1
    local brick out 2
    map smog out 12 radius 1
    log -timestamp=Time energy 4
end

# --- Arc furnaces are clean and fast, and the only way to make steel and carbide.

unitRule arcIron
    appliesTo arc
    rate 40
    local ironOre in 2
    network power in 6
    local ironPlate out 2
    log -timestamp=Time energy 6
end
unitRule arcCopper
    appliesTo arc
    rate 40
    local copperOre in 2
    network power in 6
    local copperPlate out 2
    log -timestamp=Time energy 6
end
unitRule arcBrick
    appliesTo arc
    rate 60
    local stone in 3
    network power in 8
    local brick out 2
    log -timestamp=Time energy 8
end
unitRule arcSteel
    appliesTo arc
    rate 150
    local ironPlate in 3
    local coal in 1
    network power in 15
    local steel out 1
    log -timestamp=Time energy 15
end
unitRule arcCarbide
    appliesTo arc
    rate 120
    local tungstenOre in 1
    local coal in 2
    network power in 20
    local carbide out 1
    log -timestamp=Time energy 20
end

# --- Workshops are slow and unpowered. Assembly lines are fast and make everything.

unitRule workshopGear
    appliesTo workshop
    rate 90
    local ironPlate in 2
    local gear out 1
end
unitRule workshopWire
    appliesTo workshop
    rate 60
    local copperPlate in 1
    local wire out 2
end
unitRule workshopCircuit
    appliesTo workshop
    rate 150
    local ironPlate in 1
    local wire in 3
    local circuit out 1
end

unitRule assemblyGear
    appliesTo assembly
    rate 30
    local ironPlate in 2
    network power in 3
    local gear out 1
    log -timestamp=Time energy 3
end
unitRule assemblyWire
    appliesTo assembly
    rate 20
    local copperPlate in 1
    network power in 2
    local wire out 2
    log -timestamp=Time energy 2
end
unitRule assemblyCircuit
    appliesTo assembly
    rate 50
    local ironPlate in 1
    local wire in 3
    network power in 5
    local circuit out 1
    log -timestamp=Time energy 5
end
unitRule assemblyMotor
    appliesTo assembly
    rate 120
    local steel in 1
    local gear in 2
    local wire in 4
    network power in 15
    local motor out 1
    log -timestamp=Time energy 15
end
unitRule assemblyController
    appliesTo assembly
    rate 180
    local circuit in 2
    local plastic in 1
    local carbide in 1
    network power in 25
    local controller out 1
    log -timestamp=Time energy 25
end
unitRule assemblyAutomaton
    appliesTo assembly
    rate 360
    local motor in 1
    local controller in 1
    local brick in 4
    network power in 60
    local automaton out 1
    log -timestamp=Time energy 60
    log automata 1
end

# Tar leaves from the refinery's left side. If it backs up, the refinery stops.
unitRule refine
    appliesTo refinery
    rate 120
    network crude in 10
    network water in 5
    network power in 10
    local plastic out 2
    local tar out 1 left
    log -timestamp=Time energy 10
end

# --- Power

unitRule steamPower
    appliesTo steam
    rate 120
    local coal in 1
    network water in 5
    network power out 60
    map smog out 18 radius 1
end
unitRule burnTar
    appliesTo burner
    rate 120
    local tar in 1
    network power out 40
    map smog out 24 radius 1
end
unitRule sunlight
    appliesTo solar
    rate 300
    network power out 10
end

# Smog thins out by itself, so spacing dirty machines apart keeps them running.
mapRule smogClears
    rate 30
    map smog in 3
end

# --- The starting map

patch ironField     at 0 0    size 7 6 amount 100000
patch coalField     at 0 8    size 7 5 amount 100000
patch copperField   at 16 11  size 6 5 amount 100000
patch waterField    at 10 14  size 5 4 amount 1000
patch stoneField    at -8 3   size 5 6 amount 100000
patch tungstenField at 28 3   size 5 4 amount 100000
patch oilField      at 24 18  size 5 4 amount 100000

# --- What things cost. Depots feed the shared stock that pays for all of it.
# Removing a building refunds it in full.

stock ironPlate 150 gear 30

cost belt       ironPlate 1
cost express    ironPlate 2 gear 1
cost splitter   ironPlate 4 gear 2
cost sorter     ironPlate 4 gear 2 circuit 1
cost tunnel     ironPlate 6
cost hoist      ironPlate 8 gear 2
cost chute      ironPlate 6
cost pillar     ironPlate 3
cost depot      ironPlate 10
cost drill      ironPlate 8 gear 3
cost powerDrill steel 4 gear 6 wire 6
cost pump       ironPlate 5 gear 2
cost derrick    steel 10 gear 8 wire 10
cost furnace    ironPlate 6
cost arc        steel 4 wire 12 brick 10
cost workshop   ironPlate 8 gear 4
cost assembly   steel 10 gear 10 circuit 6
cost refinery   steel 20 circuit 10 brick 20
cost steam      ironPlate 20 gear 6 brick 10
cost burner     steel 6 brick 10
cost solar      copperPlate 20 circuit 4
cost pole       ironPlate 2 wire 2
cost pipe       ironPlate 1

# --- The research tree

research routing
    name "Routing"
    cost ironPlate 30 gear 10
    time 300
    unlocks splitter tunnel
end
research copperWorking
    name "Copper working"
    cost ironPlate 40
    time 300
    unlocks furnaceCopper workshopWire
end
research masonry
    name "Masonry"
    cost ironPlate 40 gear 10
    time 300
    unlocks furnaceBrick
end
research electricity
    name "Electricity"
    requires copperWorking masonry
    cost copperPlate 40 wire 40 brick 20
    time 600
    unlocks steam pump pipe pole
end
research metallurgy
    name "Metallurgy"
    requires electricity
    cost ironPlate 80 brick 40 wire 40
    time 600
    unlocks arc arcSteel
end
research electronics
    name "Electronics"
    requires electricity
    cost ironPlate 60 wire 80
    time 600
    unlocks workshopCircuit sorter
end
research expressBelts
    name "Express belts"
    requires routing metallurgy
    cost steel 20 gear 60
    time 600
    unlocks express
end
research poweredMining
    name "Powered mining"
    requires metallurgy
    cost steel 30 gear 40 wire 40
    time 900
    unlocks powerDrill
end
research solarPower
    name "Solar power"
    requires electronics
    cost copperPlate 60 circuit 30
    time 900
    unlocks solar
end
research automation
    name "Automation"
    requires metallurgy electronics
    cost steel 40 gear 60 circuit 40
    time 1200
    unlocks assembly
end
research tungsten
    name "Tungsten carbide"
    requires poweredMining
    cost steel 60 circuit 60
    time 1200
    unlocks powerDrillTungsten arcCarbide
end
research petroleum
    name "Petroleum"
    requires automation
    cost steel 80 circuit 80 brick 60
    time 1800
    unlocks derrick refinery burner
end
research motors
    name "Motors"
    requires automation
    cost steel 80 gear 200 wire 200
    time 1800
    unlocks assemblyMotor
end
research robotics
    name "Robotics"
    requires tungsten petroleum motors
    cost motor 30 carbide 30 plastic 60
    time 3600
    unlocks assemblyController assemblyAutomaton
end
research elevation
    name "Elevated logistics"
    requires routing
    cost ironPlate 60 gear 6
    time 480
    unlocks hoist chute pillar
end

# --- The opening factory: iron and coal into a furnace, plates into a depot.

place drill 2 2 east
place belt 3 2 east count 6
place drill 2 9 east
place belt 3 9 east count 6
place belt 9 9 north count 7
place furnace 9 2 east
place belt 10 2 east count 10
place depot 20 2 east

# --- Puzzles. The campaign carries on in one factory, one goal after another.
# The rushes start on a map of their own and are timed: every try is a new round.

puzzle plates
    name "Plates for days"
    about "Keep the opening line running and build more of it: deliver 200 iron plates."
    goal deliver ironPlate 200
end
puzzle copper
    name "Copper"
    about "Research copper working, then smelt and deliver 100 copper plates."
    goal research copperWorking
    goal deliver copperPlate 100
end
puzzle powerOn
    name "Power on"
    about "Fire bricks, draw wire and research electricity."
    goal research electricity
end
puzzle steelWorks
    name "Steel works"
    about "Arc furnaces only run on power. Make 50 steel."
    goal make steel 50
end
puzzle circuitry
    name "Circuitry"
    about "Deliver 100 circuits."
    goal deliver circuit 100
end
puzzle assemblyLine
    name "Assembly line"
    about "Research automation."
    goal research automation
end
puzzle firstAutomaton
    name "The first automaton"
    about "Motors, controllers, bricks and a lot of power: build one automaton."
    goal metric automata 1
end
puzzle productionRun
    name "Production run"
    about "Build 25 automata. Then keep going for as long as you like."
    goal metric automata 25
end

puzzle gearRush
    name "Gear rush"
    about "A bare map, 120 plates and five minutes: deliver 100 gears."
    fresh
    stock ironPlate 120 gear 20
    place none
    only belt drill furnace workshop depot
    goal deliver gear 100
    limit 18000
end
puzzle cleanAir
    name "Clean air"
    about "Coal furnaces choke on their own smog. Deliver 600 iron plates in eight minutes without letting them stall."
    fresh
    stock ironPlate 200 gear 60
    place none
    only belt splitter drill furnace depot
    researched routing
    goal deliver ironPlate 600
    limit 28800
end

# Chapter puzzles: each on a fresh map. Their solutions are in
# crates/sim/tests/solutions/base.sol.

puzzle firstFire
    chapter "First fires"
    name "First fire"
    about "Iron ore, coal and sixty plates. Smelt and deliver 20 iron plates."
    fresh
    patch ironField at 0 0 size 3 2 amount 100000
    patch coalField at 0 4 size 3 2 amount 100000
    stock ironPlate 60 gear 10
    place none
    only belt drill furnace depot
    goal deliver ironPlate 20
end
puzzle nightShift
    chapter "First fires"
    name "Night shift"
    about "The night shift left the line in pieces and ten plates in the stock. Mend it and deliver 40 iron plates."
    fresh
    stock ironPlate 61 gear 6
    place drill 2 2 east
    place belt 3 2 east count 6
    place drill 2 9 east
    place belt 3 9 east count 6
    place belt 9 9 north count 3
    place furnace 9 2 east
    place belt 10 2 east count 4
    place depot 20 2 east
    only belt
    goal deliver ironPlate 40
    limit 7800
end
puzzle gearTrain
    chapter "First fires"
    name "Gear train"
    about "The plate line works, but today the order is for gears. Fit a workshop into it and deliver 30 gears."
    fresh
    stock ironPlate 69 gear 10
    only belt workshop
    goal deliver gear 30
    limit 10800
end
puzzle shoulder
    chapter "First fires"
    name "Shoulder to shoulder"
    about "No belts at all, and just enough for two drills, a furnace and a depot. Deliver 25 iron plates."
    fresh
    patch ironField at 0 0 size 1 3 amount 100000
    patch coalField at 1 3 size 3 1 amount 100000
    stock ironPlate 32 gear 6
    place none
    only drill furnace depot
    goal deliver ironPlate 25
end
puzzle longHaul
    chapter "First fires"
    name "The long haul"
    about "Iron in the east, coal in the south and the depot in the corner, with few plates to spare. Deliver 40 iron plates."
    fresh
    patch ironField at 20 0 size 2 2 amount 100000
    patch coalField at 0 20 size 2 2 amount 100000
    stock ironPlate 75 gear 6
    place depot 0 0 east
    only belt drill furnace
    goal deliver ironPlate 40
    limit 8400
end
puzzle thinSeam
    chapter "First fires"
    name "Thin seam"
    about "Each patch of this seam holds only ten ore, and you can afford a single iron drill. Move it along and deliver 50 iron plates."
    fresh
    patch ironField at 0 0 size 6 1 amount 10
    patch coalField at 6 3 size 2 1 amount 100000
    stock ironPlate 50 gear 6
    place none
    only belt drill furnace depot
    goal deliver ironPlate 50
    limit 11400
end
puzzle sevenGears
    chapter "First fires"
    name "Seven gears"
    about "Seven gears: two drills and no workshop, or one drill and a workshop. Find a way to deliver 20 gears."
    fresh
    patch ironField at 0 0 size 2 2 amount 100000
    patch coalField at 0 3 size 2 2 amount 100000
    stock ironPlate 60 gear 7
    place none
    only belt drill furnace workshop depot
    goal deliver gear 20
end
puzzle copperRush
    chapter "First fires"
    name "Copper rush"
    about "Earn the plates to research copper working, then draw and deliver 20 wire."
    fresh
    patch ironField at 0 0 size 3 3 amount 100000
    patch coalField at 0 5 size 3 3 amount 100000
    patch copperField at 8 5 size 3 3 amount 100000
    stock ironPlate 70 gear 16
    place none
    only belt drill furnace workshop depot
    goal research copperWorking
    goal deliver wire 20
    limit 10200
end
puzzle rainyDay
    chapter "First fires"
    name "Rainy day"
    about "Build up, then stop spending: have 300 iron plates in the stock at once."
    fresh
    patch ironField at 0 0 size 2 10 amount 100000
    patch coalField at 8 0 size 2 10 amount 100000
    stock ironPlate 80 gear 18
    place none
    only belt drill furnace depot
    goal stock ironPlate 300
    limit 18600
end
puzzle orderBook
    chapter "First fires"
    name "Order book"
    about "Four orders at once: 60 iron plates, 40 copper plates, 30 bricks and 20 gears. You can't afford every line at the start."
    fresh
    patch ironField at 0 0 size 12 2 amount 100000
    patch coalField at 0 3 size 12 2 amount 100000
    patch copperField at 0 6 size 6 2 amount 100000
    patch stoneField at 6 6 size 6 2 amount 100000
    stock ironPlate 100 gear 22
    place none
    researched copperWorking masonry
    only belt drill furnace workshop depot
    goal deliver ironPlate 60
    goal deliver copperPlate 40
    goal deliver brick 30
    goal deliver gear 20
    limit 11400
end

puzzle forkRoad
    chapter "Crossings"
    name "Fork in the road"
    about "Two furnaces and a single speck of coal. Share it out and deliver 80 iron plates."
    fresh
    patch ironField at 0 0 size 1 1 amount 100000
    patch ironField at 0 4 size 1 1 amount 100000
    patch coalField at 0 2 size 1 1 amount 100000
    stock ironPlate 70 gear 11
    place none
    researched routing
    only belt splitter drill furnace depot
    goal deliver ironPlate 80
    limit 9000
end
puzzle crossroads
    chapter "Crossings"
    name "Crossroads"
    about "The copper ore runs south to its depot, right across the way from iron to coal. Deliver 30 iron plates and 30 copper ore without mixing them."
    fresh
    patch ironField at 0 0 size 1 1 amount 100000
    patch coalField at 12 1 size 1 1 amount 100000
    patch copperField at 6 -10 size 1 1 amount 100000
