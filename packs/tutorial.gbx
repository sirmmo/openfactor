# OpenFactor tutorial pack: one small step at a time.
#
# A few ores, a furnace, a workshop and belts. Each puzzle adds one idea and
# carries on in the same factory, so what you built for the last one keeps
# working for the next.

title "First steps"
summary "A short guided start: dig, carry, smelt and make parts, one goal at a time."

belt belt name "Belt" speed 16 model conveyor corner conveyor-corner

resource ironOre     name "Iron ore"     sprite 96 tint 8fa3c0 model survival/resource-stone
resource copperOre   name "Copper ore"   sprite 97 tint d07f43 model survival/resource-stone
resource coal        name "Coal"         sprite 96 tint 26262e model survival/resource-stone
resource ironPlate   name "Iron plate"   sprite 107 model survival/metal-panel
resource copperPlate name "Copper plate" sprite 107 tint d07f43 model survival/metal-panel
resource gear        name "Gear"         sprite 114 model cog-a
resource wire        name "Wire"         sprite 130 tint d07f43

layer ironField   name "iron ground"   sprites 3 32 tint 6f8fb8 decor 45% survival/rock-a@0.45 survival/rock-b@0.45 survival/rock-c@0.4
layer copperField name "copper ground" sprites 3 32 tint c8763c decor 45% survival/rock-a@0.45 survival/rock-b@0.45 survival/rock-c@0.4
layer coalField   name "coal ground"   sprites 3 32 tint 15151a decor 45% survival/rock-a@0.45 survival/rock-c@0.4

unit splitter name "Splitter"     sprite 72  group "Logistics" routes split model conveyor-cross
unit depot    name "Depot"        sprite 58  group "Logistics" stores shared model box-wide
unit drill    name "Drill"        sprite 110 group "Extraction" placeOn ironField placeOn copperField placeOn coalField model piston-round
unit furnace  name "Furnace"      sprite 92  group "Production" model hopper-round
unit workshop name "Workshop"     sprite 87  group "Production" model machine

describe belt     "Carries items one tile at a time in the direction it faces. Drag to lay a line."
describe splitter "Takes turns sending what arrives out of its front, left and right."
describe depot    "Accepts anything. What it receives joins the stock that pays for building."
describe drill    "Digs whatever ore is under it and sends it out of its front."
describe furnace  "Smelts two ore with one coal into two plates. Feed it from any side."
describe workshop "Turns plates into parts. Pick a recipe in its inspector, or let it choose."
describe ironOre     "Dug from iron ground."
describe copperOre   "Dug from copper ground."
describe coal        "Dug from coal ground. Furnaces burn it."
describe ironPlate   "Pays for almost everything."
describe copperPlate "Drawn into wire."
describe gear        "A moving part, made from iron plates."
describe wire        "Drawn from copper plates."

unitRule digIron
    appliesTo drill
    rate 45
    map ironField in 1
    local ironOre out 1
end
unitRule digCopper
    appliesTo drill
    rate 45
    map copperField in 1
    local copperOre out 1
end
unitRule digCoal
    appliesTo drill
    rate 45
    map coalField in 1
    local coal out 1
end
unitRule smeltIron
    appliesTo furnace
    rate 90
    local ironOre in 2
    local coal in 1
    local ironPlate out 2
end
unitRule smeltCopper
    appliesTo furnace
    rate 90
    local copperOre in 2
    local coal in 1
    local copperPlate out 2
end
unitRule makeGear
    appliesTo workshop
    rate 60
    local ironPlate in 2
    local gear out 1
end
unitRule drawWire
    appliesTo workshop
    rate 45
    local copperPlate in 1
    local wire out 2
end

patch ironField   at 0 0   size 5 4 amount 100000
patch coalField   at 0 7   size 5 3 amount 100000
patch copperField at 12 0  size 4 4 amount 100000

stock ironPlate 80

cost belt     ironPlate 1
cost splitter ironPlate 4
cost depot    ironPlate 5
cost drill    ironPlate 5
cost furnace  ironPlate 5
cost workshop ironPlate 6

puzzle dig
    name "1. Dig"
    about "Put a drill on the blue iron ground, run a belt from the way it faces to a depot, and deliver 10 iron ore."
    goal deliver ironOre 10
end
puzzle smelt
    name "2. Smelt"
    about "A furnace needs ore and coal. Belt both into one, and its plates into a depot: deliver 20 iron plates."
    goal deliver ironPlate 20
end
puzzle gears
    name "3. Gears"
    about "Feed plates into a workshop and deliver 10 gears. A splitter can share one plate line between the depot and the workshop."
    goal deliver gear 10
end
puzzle copper
    name "4. Copper"
    about "The same furnace smelts copper ore. Deliver 20 copper plates."
    goal deliver copperPlate 20
end
puzzle wire
    name "5. Wire"
    about "A second workshop set to wire: deliver 40 wire."
    goal deliver wire 40
end
puzzle allTogether
    name "6. All together"
    about "Everything at once, and in quantity: 100 iron plates, 30 gears and 60 wire. Then the factory is yours."
    goal deliver ironPlate 100
    goal deliver gear 30
    goal deliver wire 60
end

# Chapter puzzles: each on a fresh map, each teaching or practising one idea.
# Their solutions are in crates/sim/tests/solutions/tutorial.sol.

puzzle hello
    chapter "Groundwork"
    name "Hello, drill"
    about "A drill and a depot are already here. Lay a belt between them and deliver 10 iron ore."
    fresh
    place drill 2 1 east
    place depot 7 1 east
    only belt
    goal deliver ironOre 10
end
puzzle roundTheBend
    chapter "Groundwork"
    name "Round the bend"
    about "The depot is down and to the left of the copper. Belts can turn: drag one line, then another. Deliver 20 copper ore."
    fresh
    place depot 8 6 east
    only belt drill
    goal deliver copperOre 20
end
puzzle pocketMoney
    chapter "Groundwork"
    name "Pocket money"
    about "Ten plates buy a drill and a depot, and not one belt. A drill can face straight into a depot. Deliver 15 coal."
    fresh
    stock ironPlate 10
    place none
    only belt drill depot
    goal deliver coal 15
end
puzzle fourSides
    chapter "Groundwork"
    name "Four sides"
    about "Four specks of ore around one depot, and no belts. A depot takes from every side: deliver 30 iron ore, 20 copper ore and 20 coal."
    fresh
    patch ironField at 4 3 size 1 1 amount 100000
    patch ironField at 3 4 size 1 1 amount 100000
    patch copperField at 5 4 size 1 1 amount 100000
    patch coalField at 4 5 size 1 1 amount 100000
    place depot 4 4 east
    only drill
    goal deliver ironOre 30
    goal deliver copperOre 20
    goal deliver coal 20
    limit 4800
end
puzzle threeOres
    chapter "Groundwork"
    name "Three ores, one belt"
    about "A belt carries any mix of things, and a depot takes them all. Deliver 25 of each ore to a single depot."
    fresh
    place none
    only belt drill depot
    goal deliver ironOre 25
    goal deliver copperOre 25
    goal deliver coal 25
    limit 6000
end
puzzle combSeam
    chapter "Groundwork"
    name "Narrow seam"
    about "The coal runs in a thin line. Drills can feed a belt from its side, so line them up along one belt. Deliver 150 coal."
    fresh
    patch coalField at 3 0 size 1 6 amount 100000
    place depot 4 8 east
    stock ironPlate 60
    only belt drill
    goal deliver coal 150
    limit 5400
end
puzzle everyLastOre
    chapter "Groundwork"
    name "Every last ore"
    about "Four tiny deposits of ten ore each, and money for three drills. Removing a building gives back all it cost. Deliver 40 iron ore."
    fresh
    patch ironField at 3 4 size 1 1 amount 10
    patch ironField at 5 4 size 1 1 amount 10
    patch ironField at 4 3 size 1 1 amount 10
    patch ironField at 4 5 size 1 1 amount 10
    stock ironPlate 20
    place none
    only belt drill depot
    goal deliver ironOre 40
end
puzzle longHaul
    chapter "Groundwork"
    name "Long haul"
    about "The iron is thirty tiles from the depot, and the plates just cover the belt. Deliver 20 iron ore."
    fresh
    patch ironField at 30 4 size 2 2 amount 100000
    place depot 0 4 east
    stock ironPlate 40
    only belt drill
    goal deliver ironOre 20
end
puzzle meetInTheMiddle
    chapter "Groundwork"
    name "Meet in the middle"
    about "Copper in one corner, coal in the other, the depot between them. Deliver 25 of each, on a budget."
    fresh
    patch copperField at 0 0 size 2 2 amount 100000
    patch coalField at 20 12 size 2 2 amount 100000
    place depot 10 6 east
    stock ironPlate 45
    only belt drill
    goal deliver copperOre 25
    goal deliver coal 25
    limit 6000
end
puzzle quarry
    chapter "Groundwork"
    name "Quarry"
    about "Forty plates for a whole quarry: deliver 300 iron ore. Every plate spent on belt is a drill you don't have."
    fresh
    stock ironPlate 40
    place none
    only belt drill depot
    goal deliver ironOre 300
    limit 7800
end

puzzle firstFire
    chapter "Fire and coal"
    name "First fire"
    about "This furnace has iron ore but no coal. Dig some coal and feed it in from the other side: deliver 10 iron plates."
    fresh
    place drill 2 3 south
    place belt 2 4 south
    place furnace 2 5 east
    place depot 3 5 east
    only belt drill
    goal deliver ironPlate 10
end
puzzle cheekToCheek
    chapter "Fire and coal"
    name "Cheek to cheek"
    about "Twenty plates and no belts. Drills can face straight into a furnace, and a furnace straight into a depot. Deliver 20 iron plates."
    fresh
    patch ironField at 2 2 size 1 1 amount 100000
    patch coalField at 3 3 size 1 1 amount 100000
    stock ironPlate 20
    place none
    only drill furnace depot
    goal deliver ironPlate 20
end
puzzle copperGlow
    chapter "Fire and coal"
    name "Copper glow"
    about "A furnace smelts copper ore just as well, but the coal is across the map. Deliver 30 copper plates."
    fresh
    place none
    only belt drill furnace depot
    goal deliver copperPlate 30
end
puzzle payday
    chapter "Fire and coal"
    name "Payday"
    about "Plates that reach a depot join your stock and pay for building. Start with 25 and have 100 iron plates at once."
