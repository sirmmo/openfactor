    only belt splitter drill furnace depot
    goal deliver ironPlate 160
    limit 10800
end
puzzle twoOresOneFire
    chapter "Fire and coal"
    name "One furnace, two ores"
    about "You may not build a furnace, but this one has four sides: iron ore, copper ore, coal, and the way out. Deliver 20 of each plate."
