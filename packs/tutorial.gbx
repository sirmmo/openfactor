puzzle wrongWay
    chapter "Mend and finish"
    name "One wrong turn"
    about "This factory would work if one belt didn't face backwards. Remove it and lay it the right way: deliver 20 iron plates."
    fresh
    place drill 2 3 south
    place belt 2 4 south
    place furnace 2 5 east
    place belt 3 5 east
    place belt 4 5 west
    place belt 5 5 east
    place depot 6 5 east
    place drill 2 7 north
    place belt 2 6 north
    only belt
    goal deliver ironPlate 20
end
puzzle turnAround
    chapter "Mend and finish"
    name "Turn around"
    about "Both drills were built facing the wrong way. Removing gives back what they cost, so build them again facing right. Deliver 30 wire."
    fresh
    patch copperField at 12 0 size 4 4 amount 100000
    patch coalField at 12 6 size 1 1 amount 100000
    place drill 12 3 west
    place furnace 12 4 east
    place workshop 13 4 east
    place depot 14 4 east
    place belt 12 5 north
    place drill 12 6 south
    only drill
    goal deliver wire 30
end
puzzle potholes
    chapter "Mend and finish"
    name "Potholes"
    about "The belts have three holes in them. Find them and fill them: deliver 15 gears."
    fresh
    place drill 0 2 east
    place belt 1 2 east count 3
    place belt 5 2 east count 4
    place furnace 9 2 east
    place belt 10 2 east
    place belt 12 2 east
    place workshop 13 2 east
    place depot 14 2 east
    place drill 4 7 east
    place belt 5 7 east count 4
    place belt 9 7 north count 2
    place belt 9 4 north count 2
    only belt
    goal deliver gear 15
    limit 5400
end
puzzle scrapyard
    chapter "Mend and finish"
    name "Scrapyard"
    about "Not a plate in the stock, and a yard full of things nobody needs. Clear what you don't need, keep the depot that's well placed, and deliver 30 iron plates."
