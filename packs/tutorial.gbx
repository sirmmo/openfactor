    only belt drill depot
    goal deliver ironPlate 20
    goal deliver copperPlate 20
end
puzzle everyLump
    chapter "Fire and coal"
    name "Every lump"
    about "Three small coal deposits, thirty lumps in all, and each lump smelts two plates. Waste none: deliver 60 iron plates."
