    stock copper 40 silicon 10
    place none
    only belt dredge smelter slicer dock panel pole
    goal deliver wafer 30
    limit 5400
end
puzzle nightShift
    chapter "Sand and sun"
    name "Night shift"
    about "The day crew left the line broken: a slicer the wrong way round, a gap in the belt, and no power. Fix it and ship 40 wafers."
    fresh
    patch dunes at 1 2 size 1 1 amount 100000
    stock copper 46 silicon 10
    place dredge 1 2 east
    place smelter 2 2 east
    place slicer 3 2 west
    place belt 4 2 east count 3
    place belt 8 2 east
    place dock 9 2 east
    place panel 4 8 east
    place pole 3 8 east
    only belt pole slicer
    goal deliver wafer 40
    limit 5400
end
